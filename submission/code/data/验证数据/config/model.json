    "heat_audit": "integral(rho*cp*T_t,dV) + integral(h*(T_s-T_inf),dA) = 0",
    "moisture_audit": "d_t(integral(C,dV)) + integral(h_m*(C_s-C_eq),dA) = 0",
    "omitted_heat_terms": [
